# =============================================================================
# AI Career Navigator — environment configuration
# Copy this file to .env (for local dev) and fill in real values.
# Never commit .env or real secrets to version control.
# =============================================================================

# ---- Database (required) ----
# PostgreSQL connection string. Local dev via docker-compose defaults to:
#   postgresql://acn:devpassword@localhost:5432/ai_career_navigator
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/ai_career_navigator"

# ---- Auth (required) ----
# Random secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-real-random-32+-character-secret"

# ---- AI provider (required in production) ----
# Server-side only — never exposed to the client. Without this set, the app
# falls back to a deterministic, clearly-labeled, non-AI development
# placeholder (see src/lib/ai/providers/dev-mock.ts) and refuses to start
# that fallback at all when NODE_ENV=production.
ANTHROPIC_API_KEY=""

# Optional: override the default Anthropic model. Verify the current valid
# model identifier against Anthropic's docs before deploying — this default
# may not reflect the latest available model at the time you deploy.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---- App metadata ----
NODE_ENV="development"
# In production behind the Caddy reverse proxy (see docker-compose.yml),
# set this to your real public URL, e.g. https://app.example.com — it's
# used to build Stripe checkout redirect URLs and other absolute links.
APP_URL="http://localhost:3000"

# Only used by docker-compose.yml's `caddy` service, to request a TLS
# certificate and route traffic. Must be a real domain pointing at this
# server's IP — not needed for local `npm run dev`.
DOMAIN=""

# Sender address for future transactional email (password reset, in-app
# notification digests, etc.) — the email-sending integration itself is not
# yet implemented; this var is read but currently only used as a config
# placeholder for that future work.
EMAIL_FROM="no-reply@example.com"

# ---- File storage ----
# Local filesystem path for uploaded CVs (dev/single-instance only). For a
# real multi-instance production deployment, replace LocalFileStorage in
# src/lib/storage/index.ts with an S3-compatible implementation of the same
# StorageProvider interface — no other code needs to change.
STORAGE_LOCAL_PATH="./storage/uploads"

# ---- Billing (Stripe) ----
# Required for the 3-day-trial -> Premium subscription flow. Without these,
# the app still runs and the trial/lock logic still works, but the
# "Upgrade to Premium" button will show a "billing not configured" error.
#
# STRIPE_SECRET_KEY: from the Stripe Dashboard (Developers > API keys).
#   Use a test-mode key (sk_test_...) until you're ready to go live.
# STRIPE_PRICE_ID: create a recurring Price for your Premium plan in the
#   Stripe Dashboard (Product catalog) and paste its ID (price_...) here.
#   The dollar amount lives entirely in Stripe, not in this codebase.
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint you create in the Stripe
#   Dashboard pointing at <APP_URL>/api/billing/webhook (whsec_...). Also
#   settable via `stripe listen --forward-to localhost:3000/api/billing/webhook`
#   for local testing with the Stripe CLI.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
